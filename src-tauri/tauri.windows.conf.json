{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Popper",
    "version": "0.5.9",
    "identifier": "com.local.popper",
    "app": {
        "windows": [
            {
                "label": "settings",
                "title": "Popper 设置面板",
                "url": "settings/index.html",
                "width": 960,
                "height": 780,
                "minWidth": 760,
                "minHeight": 600,
                "visible": false,
                "center": true,
                "resizable": true,
                "fullscreen": false,
                "skipTaskbar": false
            }
        ]
    },
    "bundle": {
        "targets": [
            "nsis"
        ],
        "icon": [
            "../apps/windows/icons/icon.ico"
        ],
        "shortDescription": "轻量 Windows 划词助手",
        "windows": {
            "allowDowngrades": false,
            "webviewInstallMode": {
                "type": "downloadBootstrapper",
                "silent": true
            },
            "nsis": {
                "installerIcon": "../apps/windows/icons/icon.ico",
                "uninstallerIcon": "../apps/windows/icons/icon.ico",
                "installMode": "currentUser",
                "languages": [
                    "SimpChinese",
                    "English"
                ],
                "displayLanguageSelector": false,
                "compression": "lzma",
                "startMenuFolder": "Popper"
            }
        }
    }
}
