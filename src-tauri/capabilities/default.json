{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Minimal permissions shared by Popper local renderer windows",
    "windows": [
        "settings",
        "selection-toolbar",
        "quick-ask",
        "selection-result-*",
        "capture-session-*",
        "capture-pin-*"
    ],
    "permissions": [
        "core:event:allow-listen",
        "core:event:allow-unlisten",
        "core:window:allow-start-dragging",
        "core:window:allow-start-resize-dragging"
    ]
}